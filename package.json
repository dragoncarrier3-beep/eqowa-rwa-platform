{
  "name": "eqowa-rwa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Institutional RWA tokenization and compliance engine for Eqowa Fintech.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "node -e \"process.env.REPORT_GAS='true';require('child_process').execSync('npx hardhat test',{stdio:'inherit'})\"",
    "coverage": "hardhat coverage",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "format": "prettier --write \"contracts/**/*.sol\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"config/**/*.ts\" \"apps/api/src/**/*.ts\" \"apps/web/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"contracts/**/*.sol\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"config/**/*.ts\" \"apps/api/src/**/*.ts\" \"apps/web/**/*.{ts,tsx}\"",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "create-safe:amoy": "hardhat run scripts/createSafe.ts --network amoy",
    "deploy-settlement:amoy": "hardhat run scripts/deploySettlement.ts --network amoy",
    "transfer-ownership:amoy": "hardhat run scripts/transferOwnership.ts --network amoy",
    "verify:amoy": "hardhat run scripts/verify.ts --network amoy",
    "publish-addresses": "hardhat run scripts/publishAddresses.ts --network amoy",
    "api:dev": "npm --prefix apps/api run dev",
    "api:test": "npm --prefix apps/api test",
    "api:migrate": "npm --prefix apps/api run migrate",
    "api:index": "npm --prefix apps/api run index",
    "api:worker": "npm --prefix apps/api run worker",
    "api:admin:invite": "npm --prefix apps/api run admin:invite --",
    "simulate:local": "npm --prefix apps/api run simulate:local",
    "simulate:amoy": "npm --prefix apps/api run simulate -- --network amoy",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web test",
    "web:lint": "npm --prefix apps/web run lint",
    "web:typecheck": "npm --prefix apps/web run typecheck"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@onchain-id/solidity": "^2.2.1",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.15",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^5.0.3",
    "typescript": "^5.6.3"
  }
}
