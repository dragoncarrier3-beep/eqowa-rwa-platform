# API, workers and the shared test chain seed. Build from the repo root:
#   docker compose -f deploy/docker-compose.aws.yml build api
# The image carries Hardhat and the compiled contracts because the seed deploys
# with the production scripts, and the API imports the repo-level config/.
FROM node:22-bookworm-slim

WORKDIR /repo

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY apps/api/package.json apps/api/package-lock.json ./apps/api/
RUN npm --prefix apps/api ci --no-audit --no-fund

COPY hardhat.config.ts tsconfig.json ./
COPY contracts ./contracts
COPY config ./config
COPY scripts ./scripts
RUN npx hardhat compile

COPY apps/api ./apps/api

# Writable places for the node user: the seed's deployment record, simulation
# reports, Hardhat's cache, uploaded documents and the chain state volume.
RUN mkdir -p deployments reports data /state \
  && chown -R node:node deployments reports data cache artifacts typechain-types /state

USER node
ENV NODE_ENV=production
EXPOSE 3001

CMD ["sh", "-c", "npm --prefix apps/api run migrate && npm --prefix apps/api start"]
