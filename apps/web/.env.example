# Copy to apps/web/.env.local for `npm run web:dev`. Never commit .env.local.

# Server side only: where the Next.js server reaches the API (the /api proxy
# and the landing page figures). Browsers never see this URL.
API_INTERNAL_URL=http://127.0.0.1:3001

# NEXT_PUBLIC_ values are built into the page and visible to every visitor.
# Chain the portal runs on: 31337 local node, 80002 Polygon Amoy, 137 Polygon.
# Must match CHAIN_ID in the API .env, or sign-in answers wrong_chain.
NEXT_PUBLIC_CHAIN_ID=31337
# Optional read RPC. Empty uses the chain's public RPC (127.0.0.1:8545 for a
# local node). Never put a keyed provider URL such as Alchemy here.
NEXT_PUBLIC_RPC_URL=
# Reown (WalletConnect) project id from Eqowa's Reown account. Public by
# design. Empty hides the WalletConnect option and leaves MetaMask only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
