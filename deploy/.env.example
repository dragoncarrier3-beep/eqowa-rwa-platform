# Shared test chain on the server. Copy to deploy/.env on the server only and
# fill in. Never commit deploy/.env. Contract addresses do not go here: the seed
# writes them to the state volume.

# Hosts. DNS A records for both must point at the server's elastic IP.
APP_DOMAIN=app.eqowa.com
API_DOMAIN=api.eqowa.com
# Let's Encrypt account email for the TLS certificates.
ACME_EMAIL=

# Database password for the Postgres container. 24+ random characters.
POSTGRES_PASSWORD=

# Session signing secret. 32+ random characters, different from any other
# environment. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_COOKIE_NAME=eqowa_session
ADMIN_COOKIE_NAME=eqowa_admin
WEBAUTHN_RP_NAME=EQOWA Admin

# WalletConnect project id (public, compiled into the web app).
WALLETCONNECT_PROJECT_ID=

# Sumsub sandbox. The webhook points at https://api.eqowa.com/webhooks/sumsub.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=id-and-liveness

# Documents. Empty keeps files on the state volume. With a bucket, give the
# EC2 instance role s3:PutObject, s3:GetObject and s3:DeleteObject on it; no
# access keys are needed on the server.
DOCUMENTS_BUCKET=
AWS_REGION=eu-north-1

# Leave empty. The admins sign in with passkeys or YubiKeys.
ADMIN_API_KEY=
