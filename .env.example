# Copy to .env and fill in. Never commit .env.

# --- Network ---
# Enterprise RPC endpoint for Polygon Amoy, supplied by Eqowa Fintech.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deployment wallet. Testnet only. Discard after handover.
DEPLOYER_PRIVATE_KEY=

# --- Contract verification ---
# Required by `npm run verify:amoy`. Create a key at polygonscan.com.
POLYGONSCAN_API_KEY=

# --- Governance addresses ---
# 2-of-3 Gnosis Safe on Amoy. Required by `npm run deploy:amoy`.
# Created by `npm run create-safe:amoy` from the signers in config/wallets.ts.
# Ownership moves here in `npm run transfer-ownership:amoy`.
GNOSIS_SAFE_ADDRESS=

# Dedicated hot wallet holding AGENT_ROLE. Mints, burns and freezes.
# Confirmed: 0xbbE038AA2406199FA565f58bbcfE2Fabaa0E6a26
AGENT_WALLET_ADDRESS=0xbbE038AA2406199FA565f58bbcfE2Fabaa0E6a26

# Claim issuer authorised to sign KYC claims on investor ONCHAINIDs.
# Optional. If empty, deploy.ts deploys a ClaimIssuer with the deployer as
# the management key. Move that key after handover.
CLAIM_ISSUER_ADDRESS=

# Token name, symbol, decimals, country list, caps and lock-up are not read
# from .env. They live in config/eqowa.ts so tests and the deploy script
# share one source of truth.
#
# Amoy gas: the deploy is about 41M gas at the 30 gwei pinned in
# config/amoyFees.ts, so roughly 1.22 POL, floor 1.41. Fund the deployer
# with 2 POL. create-safe:amoy needs only about 0.014.

# --- Milestone 2 API (local Docker Postgres) ---
# docker compose up -d postgres
# Then: npm run api:migrate && npm run api:dev
DATABASE_URL=postgres://eqowa:eqowa@127.0.0.1:5432/eqowa
API_PORT=3001

# Share price is not read from .env. It lives in config/eqowa.ts:
# 1 EQOWAG = 5 USDT (4 funds + 1 Eqowa fee).
# Quote TTL (15 minutes) and the 12-block mint gate live in config/mint.ts.

# Sumsub sandbox. App token and secret key go here. Webhook secret lands
# after Eqowa creates the webhook against POST /webhooks/sumsub.
# Empty webhook secret is mock mode (unsigned local payloads).
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com

# Signer. Env key until Eqowa provisions KMS_KEY_ARN.
# KMS_KEY_ARN wins when set. The AWS client is wired in production; tests mock it.
AGENT_SIGNER_PRIVATE_KEY=
CLAIM_ISSUER_SIGNING_KEY=
KMS_KEY_ARN=
RELAYER_PRIVATE_KEY=
# Filled from the output of `npm run deploy-settlement:amoy`.
USDT_ADDRESS=
ESCROW_ADDRESS=
FORWARDER_ADDRESS=
CHAIN_ID=80002

# Admin exception queue. Send as header x-admin-key. Empty disables /admin/*.
ADMIN_API_KEY=

# Token the indexer watches. Empty until Amoy deploy or a local node.
TOKEN_ADDRESS=
# Public GET /assets reads holders and caps from these compliance modules
# (modules.holderCountCap, balanceCap, dailyMintCap in deployments/<network>.json).
# Any left empty shows as null. Reads are cached for ASSET_CACHE_MS.
HOLDER_COUNT_MODULE_ADDRESS=
BALANCE_CAP_MODULE_ADDRESS=
DAILY_MINT_CAP_MODULE_ADDRESS=
ASSET_CACHE_MS=15000
# Escrow deploy block, printed by deploy-settlement:amoy. The settlement worker
# starts scanning here on first run and will not start without it.
INDEX_FROM_BLOCK=

# Settlement worker. Runs inside api:dev unless SETTLEMENT_WORKER=off.
# Use off when running `npm run api:worker` as a separate process.
SETTLEMENT_WORKER=on
SETTLEMENT_POLL_MS=15000
# Blocks per eth_getLogs call. Lower it if the RPC limits the range.
SETTLEMENT_LOG_CHUNK=2000
