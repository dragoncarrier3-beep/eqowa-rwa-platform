# Copy to .env and fill in. Never commit .env.

# --- Network ---
# Enterprise RPC endpoint for Polygon Amoy, supplied by Eqowa Fintech.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deployment wallet. Testnet only.
DEPLOYER_PRIVATE_KEY=

# --- Contract verification ---
POLYGONSCAN_API_KEY=

# --- Governance addresses (supplied by Eqowa Fintech) ---
# 2-of-3 Gnosis Safe on Amoy. Created by `npm run create-safe:amoy` from the
# signers in config/wallets.ts. Ownership is transferred here at the end of M1.
GNOSIS_SAFE_ADDRESS=

# Dedicated hot wallet holding AGENT_ROLE. Mints, burns and freezes.
# Confirmed: 0xbbE038AA2406199FA565f58bbcfE2Fabaa0E6a26
AGENT_WALLET_ADDRESS=0xbbE038AA2406199FA565f58bbcfE2Fabaa0E6a26

# Claim issuer authorised to sign KYC claims on investor ONCHAINIDs.
CLAIM_ISSUER_ADDRESS=

# --- Token configuration (EQOWA Group Shares) ---
TOKEN_NAME=EQOWA Group Shares
TOKEN_SYMBOL=EQOWAG
TOKEN_DECIMALS=6

# --- Compliance parameters ---
# Lockup applied to each mint tranche, in seconds. 730 days.
LOCKUP_DURATION_SECONDS=63072000

# Maximum number of distinct holders, counted by ONCHAINID identity.
MAX_HOLDER_COUNT=

# Maximum balance a single identity may hold, in base units (6 decimals).
MAX_BALANCE=
